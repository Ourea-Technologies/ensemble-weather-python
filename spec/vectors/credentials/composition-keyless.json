{
  "name": "credentials/composition-keyless",
  "description": "getComposition is an open route (security: []): sent WITHOUT X-API-Key even with a key configured. The GeoJSON routes keep the key, and their bodies are passed through untouched: wire keys (forecast_url, danger_level), no renames, no case conversion.",
  "client": {
    "api_key": "ow_pro"
  },
  "calls": [
    {
      "operation": "getComposition",
      "args": {}
    },
    {
      "operation": "getAlertOutlines",
      "args": {}
    },
    {
      "operation": "getAvalancheZones",
      "args": {}
    }
  ],
  "expect_requests": [
    {
      "method": "GET",
      "path": "/api/v1/composition",
      "query_string": "",
      "headers_absent": [
        "X-API-Key"
      ]
    },
    {
      "method": "GET",
      "path": "/api/v1/alerts/outlines",
      "query_string": "",
      "headers": {
        "X-API-Key": "ow_pro"
      }
    },
    {
      "method": "GET",
      "path": "/api/v1/avalanche/zones",
      "query_string": "",
      "headers": {
        "X-API-Key": "ow_pro"
      }
    }
  ],
  "responses": [
    {
      "status": 200,
      "headers": {
        "Content-Type": "application/json"
      },
      "body_file": "bodies/composition.json"
    },
    {
      "status": 200,
      "headers": {
        "Content-Type": "application/geo+json"
      },
      "body_file": "bodies/alert-outlines.json"
    },
    {
      "status": 200,
      "headers": {
        "Content-Type": "application/geo+json"
      },
      "body_file": "bodies/avalanche-zones.json"
    }
  ],
  "expect": {
    "results": [
      {
        "model_count": 5,
        "total_members": 164,
        "models[0].id": "aifs"
      },
      {
        "type": "FeatureCollection",
        "features[0].properties.class": "winter",
        "features[1].properties.ends": null
      },
      {
        "features[0].properties.danger_level": null,
        "features[1].properties.danger_level": 3,
        "features[1].properties.status": "rated",
        "features[1].properties.forecast_url": "https://nwac.us/avalanche-forecast/#/mt-hood"
      }
    ],
    "requests": 3
  }
}
